# Logs
# =========================
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# =========================
# Build output
# =========================
dist/
build/
**/dist/
**/build/

# =========================
# Vite
# =========================
.vite/

# =========================
# Cache
# =========================
.cache/
.parcel-cache/
.eslintcache

# =========================
# OS generated files
# =========================
.DS_Store
Thumbs.db

# =========================
# IDE files
# =========================
.vscode/
.idea/

# (optional: keep if team shares settings)
# !.vscode/extensions.json
# !.vscode/settings.json

