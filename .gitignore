# Runtime / temp files
# =========================
tmp/
temp/
*.tmp

# =========================
# Coverage / testing
# =========================
coverage/
.nyc_output/

# =========================
# Package manager lockfiles (choose ONE strategy)
# =========================

# If using npm only, KEEP package-lock.json tracked
# If mixed package managers, ignore these:

# yarn.lock
# pnpm-lock.yaml

# =========================
# Database / local dumps
# =========================
*.sql
*.sqlite
*.sqlite3

# =========================
# Prisma (if using Prisma)
# =========================
# Keep schema tracked, ignore generated binaries

prisma/generated/